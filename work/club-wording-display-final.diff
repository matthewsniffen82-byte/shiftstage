--- a/app/admin/admin-workspace-counts.ts
+++ b/app/admin/admin-workspace-counts.ts
@@ -4,14 +4,14 @@ export function adminWorkspaceCounts(operations?: AdminOperationsCenter | null)
   const attention = operations?.attention;
   const unavailable = (sections: string[]) => !operations || operations.warnings.some(warning => sections.includes(warning.section));
   const approvalSections = ["Dancer approvals", "Photo moderation", "Video moderation", "Social link reviews", "Content reports"];
-  const homeSections = [...approvalSections, "Copyright cases", "Support inbox", "Venue setup", "Club signup requests", "Club deal requests", "Club page changes"];
+  const homeSections = [...approvalSections, "Copyright cases", "Support inbox", "Club setup", "Club signup requests", "Club deal requests", "Club page changes"];
   const approvals = attention ? attention.dancerProfiles + attention.photos + attention.videos + attention.socialLinks + attention.reports : null;
   return {
     home: { value: unavailable(homeSections) ? null : attention?.total, label: "need attention" },
     approvals: { value: unavailable(approvalSections) ? null : approvals, label: "to review" },
     people: { value: unavailable(["Accounts"]) ? null : operations?.analytics.totalAccounts, label: "accounts" },
     clubs: { value: operations?.counts?.clubs, label: "clubs" },
-    money: { value: operations?.counts?.clubs, label: "venues" },
+    money: { value: operations?.counts?.clubs, label: "clubs" },
     more: { value: unavailable(["Support inbox", "Copyright cases"]) ? null : (attention?.support || 0) + (attention?.dmca || 0), label: "open cases" },
   };
 }
