{
  "name": "dancr-live-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "unrs-resolver": false
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@zxing/browser": "^0.1.5",
    "ffmpeg-static": "^5.3.0",
    "next": "15.5.24",
    "openai": "^5.10.2",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "stripe": "^16.12.0"
  },
  "scripts": {
    "generate:live-shell-version": "node scripts/generate-live-shell-version.mjs",
    "generate:live-shell-styles": "node scripts/generate-live-shell-styles.mjs",
    "generate:static-asset-versions": "node scripts/generate-static-asset-versions.mjs",
    "generate:fictional-venue-logos": "node scripts/generate-fictional-venue-logos.mjs",
    "generate:venue-logo-variants": "node scripts/generate-dark-card-venue-logos.mjs",
    "predev": "npm run generate:live-shell-version && npm run generate:live-shell-styles && npm run generate:static-asset-versions",
    "dev": "next dev",
    "prebuild": "npm run db:check-migrations && npm run generate:live-shell-version && npm run generate:live-shell-styles && npm run generate:static-asset-versions",
    "build": "next build",
    "postbuild": "node scripts/manage-layout-review-postbuild.mjs",
    "lint": "eslint . --max-warnings=0",
    "profiles:layout-review": "node scripts/manage-layout-review-profiles.mjs",
    "profiles:replace-demo-media": "node scripts/replace-layout-review-profile-media.mjs",
    "demo:working-now": "node scripts/manage-demo-working-now.mjs",
    "demo:upcoming": "node scripts/manage-demo-upcoming.mjs",
    "demo:club-deals": "node scripts/manage-demo-club-deals.mjs",
    "pretest": "npm run generate:live-shell-version && npm run generate:live-shell-styles && npm run generate:static-asset-versions",
    "test": "node --test tests/*.test.mjs",
    "privacy:purge-legacy-identity": "node scripts/purge-legacy-identity-data.mjs",
    "media:backfill-watermarks": "node scripts/backfill-public-media-watermarks.mjs",
    "media:backfill-video-posters": "node scripts/backfill-video-posters.mjs",
    "media:import-platform-tv": "node scripts/import-platform-tv-videos.mjs",
    "pretypecheck": "npm run generate:live-shell-version && npm run generate:live-shell-styles && npm run generate:static-asset-versions",
    "typecheck": "node --test tests/*.test.mjs && tsc --noEmit --incremental false",
    "start": "next start",
    "db:check-migrations": "node scripts/check-supabase-migrations.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "typescript": "^5.8.2"
  }
}
