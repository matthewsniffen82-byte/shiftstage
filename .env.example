# Dancr production environment

# Public app URL
NEXT_PUBLIC_SITE_URL=https://www.mydancr.com

# Private production access gate. Store only the SHA-256 code hash, never the code.
DANCR_SITE_ACCESS_GATE_ENABLED=false
DANCR_SITE_ACCESS_CODE_HASH=
DANCR_SITE_ACCESS_SECRET=
DANCR_SITE_ACCESS_SESSION_DAYS=7

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DANCR_ADMIN_SEED_KEY=
DANCR_MEDIA_IMPORT_KEY=
DANCR_ADMIN_SIGNUP_CODE=
DANCER_VENUE_VERIFICATION_SECRET=
DANCR_IP_HASH_SECRET=

# OpenAI server-only image moderation
OPENAI_API_KEY=
# MyDancr TV moderation: ai or temporary demo_auto_approve
DANCR_VIDEO_MODERATION_MODE=ai
DANCR_SEXUAL_REVIEW_THRESHOLD=0.92
DANCR_SEXUAL_REJECT_THRESHOLD=0.98
DANCR_VIOLENCE_REJECT_THRESHOLD=0.82
DANCR_SELF_HARM_REJECT_THRESHOLD=0.72

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_DANCER_MONTHLY_PRICE_ID=

# VerifyMyContent hosted identity verification
DANCR_IDENTITY_VERIFICATION_MODE=auto_approve
VMC_API_KEY=
VMC_API_SECRET=
VMC_ENVIRONMENT=production

# Push notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=Mydancr <no-reply@mydancr.com>

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
