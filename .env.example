# Dancr production environment

# Public app URL
NEXT_PUBLIC_SITE_URL=https://www.mydancr.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DANCR_ADMIN_SEED_KEY=
DANCR_MEDIA_IMPORT_KEY=
DANCR_ADMIN_SIGNUP_CODE=
DANCER_VENUE_VERIFICATION_SECRET=
DANCR_IP_HASH_SECRET=

# OpenAI server-only image moderation
OPENAI_API_KEY=
# MyDancr TV moderation: ai or temporary demo_auto_approve
DANCR_VIDEO_MODERATION_MODE=ai
DANCR_SEXUAL_REVIEW_THRESHOLD=0.92
DANCR_SEXUAL_REJECT_THRESHOLD=0.98
DANCR_VIOLENCE_REJECT_THRESHOLD=0.82
DANCR_SELF_HARM_REJECT_THRESHOLD=0.72

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Real dancer money movement requires this server hard stop AND the admin setting.
PAYOUTS_ENABLED=false
# Provider/business defaults; admins manage the authoritative values in-app.
# stripe, adyen, or other
PAYOUT_PROVIDER=stripe
EARNINGS_HOLD_DAYS=7
# Smallest currency unit (USD cents): 2000 = $20.00.
MINIMUM_PAYOUT_AMOUNT=2000
PAYOUT_MODE=manual_cashout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_DANCER_MONTHLY_PRICE_ID=

# Dancer commission settlement. Keep `mydancr` until the licensed NATS
# installation, affiliate portal, API user, and legal payout setup are ready.
# When set to `nats`, MyDancr cash-outs are disabled to prevent double payment.
COMMISSION_SETTLEMENT_PROVIDER=mydancr
NATS_BASE_URL=
NATS_AFFILIATE_PORTAL_URL=
NATS_API_USERNAME=
NATS_API_KEY=
# Push notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=Mydancr <no-reply@mydancr.com>

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
