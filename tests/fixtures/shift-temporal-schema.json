    {
      "acl": "{postgres=X/postgres}",
      "anon": false,
      "authenticated": false,
      "definition": "CREATE OR REPLACE FUNCTION public.set_shift_date_from_starts_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n  if new.shift_date is null then\r\n    new.shift_date := timezone(coalesce(nullif(new.timezone, ''), 'UTC'), new.starts_at)::date;\r\n  end if;\r\n  return new;\r\nend;\r\n$function$\n",
