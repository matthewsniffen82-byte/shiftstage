    {
      "definition": "CREATE TRIGGER sync_verified_auth_email AFTER UPDATE OF email ON auth.users FOR EACH ROW WHEN (((old.email)::text IS DISTINCT FROM (new.email)::text)) EXECUTE FUNCTION sync_verified_auth_email()",
      "enabled": "O",
      "table": "auth.users"
