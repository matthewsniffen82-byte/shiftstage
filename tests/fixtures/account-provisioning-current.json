    {
      "definition": "CREATE TRIGGER venue_request_email_confirmed AFTER UPDATE OF email_confirmed_at ON auth.users FOR EACH ROW WHEN (((new.email_confirmed_at IS NOT NULL) AND (old.email_confirmed_at IS DISTINCT FROM new.email_confirmed_at))) EXECUTE FUNCTION confirm_venue_request_email()",
      "enabled": "O",
      "table": "auth.users"
    },
