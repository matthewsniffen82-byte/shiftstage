    "policies": [
      {
        "cmd": "ALL",
        "permissive": "PERMISSIVE",
        "policyname": "admins manage MyDancr TV files",
        "qual": "((bucket_id = 'mydancr-tv-videos'::text) AND is_admin())",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": "((bucket_id = 'mydancr-tv-videos'::text) AND is_admin())"
      },
      {
        "cmd": "ALL",
        "permissive": "PERMISSIVE",
        "policyname": "admins manage dancer photo files",
        "qual": "((bucket_id = 'dancer-photos'::text) AND is_admin())",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": "((bucket_id = 'dancer-photos'::text) AND is_admin())"
      },
      {
        "cmd": "ALL",
        "permissive": "PERMISSIVE",
        "policyname": "admins manage moderation review files",
        "qual": "((bucket_id = 'dancr-image-moderation-review'::text) AND is_admin())",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": "((bucket_id = 'dancr-image-moderation-review'::text) AND is_admin())"
      },
      {
        "cmd": "ALL",
        "permissive": "PERMISSIVE",
        "policyname": "admins manage moderation temp files",
        "qual": "((bucket_id = 'dancr-image-moderation-temp'::text) AND is_admin())",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": "((bucket_id = 'dancr-image-moderation-temp'::text) AND is_admin())"
      },
      {
        "cmd": "ALL",
        "permissive": "PERMISSIVE",
        "policyname": "admins manage verification files",
        "qual": "((bucket_id = 'verification-documents'::text) AND is_admin())",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": "((bucket_id = 'verification-documents'::text) AND is_admin())"
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "admins read venue ownership proofs",
        "qual": "((bucket_id = 'venue-ownership-proofs'::text) AND is_admin())",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "approved dancer photos are publicly readable",
        "qual": "((bucket_id = 'dancer-photos'::text) AND (EXISTS ( SELECT 1\n   FROM (dancer_photos photo\n     JOIN dancer_profiles dancer ON ((dancer.id = photo.dancer_id)))\n  WHERE ((photo.storage_path = objects.name) AND (photo.review_status = 'approved'::review_status) AND (dancer.status = 'approved'::dancer_status) AND (dancer.verification_status = 'approved'::review_status) AND (dancer.venue_approved_at IS NOT NULL) AND (dancer.is_public = true) AND (dancer.disabled_at IS NULL)))))",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "claimants read own venue proof",
        "qual": "((bucket_id = 'venue-ownership-proofs'::text) AND (EXISTS ( SELECT 1\n   FROM venue_ownership_claims claim\n  WHERE ((claim.claimant_user_id = auth.uid()) AND (claim.proof_storage_path = objects.name)))))",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "dancers read own MyDancr TV files",
        "qual": "((bucket_id = 'mydancr-tv-videos'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "dancers read own dancer photo files",
        "qual": "((bucket_id = 'dancer-photos'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "dancers read own verification files",
        "qual": "((bucket_id = 'verification-documents'::text) AND ((storage.foldername(name))[1] = (auth.uid())::text))",
        "roles": [
          "authenticated"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "public reads venue cover images",
        "qual": "(bucket_id = 'venue-cover-images'::text)",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "public reads venue logo images",
        "qual": "(bucket_id = 'venue-logo-images'::text)",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "cmd": "SELECT",
        "permissive": "PERMISSIVE",
        "policyname": "public reads venue qr codes",
        "qual": "(bucket_id = 'venue-qr-codes'::text)",
        "roles": [
          "public"
        ],
        "schemaname": "storage",
        "tablename": "objects",
        "with_check": null
      },
      {
        "schemaname": "storage",
        "tablename": "objects",
        "policyname": "Dancer media reads require checked delivery",
        "permissive": "RESTRICTIVE",
        "roles": [
          "anon",
          "authenticated"
        ],
        "cmd": "SELECT",
        "qual": "(bucket_id <> ALL (ARRAY['dancer-photos'::text, 'mydancr-tv-videos'::text]))",
        "with_check": null
      }
    ],
    "views": [],
