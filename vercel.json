{
  "framework": "nextjs",
  "installCommand": "npx --yes npm@11.19.1 ci",
  "buildCommand": "node scripts/check-stability.mjs && npx --yes npm@11.19.1 run build",
  "functions": {
    "app/api/dancer/dashboard/route.ts": { "regions": ["pdx1"] },
    "app/api/dancer/profile/route.ts": { "regions": ["pdx1"] },
    "app/api/venue/dashboard/route.ts": { "regions": ["pdx1"] },
    "app/api/venue/operations/route.ts": { "regions": ["pdx1"] },
    "app/api/public/discovery/route.ts": { "regions": ["pdx1"] },
    "app/embed/venues/*/route.ts": { "regions": ["pdx1"] },
    "app/api/public/venue-grid/*/route.ts": {
      "regions": ["pdx1"]
    },
    "app/api/media/dancer-video/route.ts": {
      "regions": ["pdx1"]
    }
  },
  "crons": [
    { "path": "/api/cron/mailbox-retention", "schedule": "37 * * * *" },
    { "path": "/api/cron/lifecycle-retention", "schedule": "27 * * * *" },
    { "path": "/api/cron/retention-media", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/diagnostic-retention", "schedule": "17 * * * *" },
    { "path": "/api/cron/admin-review-emails", "schedule": "* * * * *" },
    { "path": "/api/cron/dancer-media-emails", "schedule": "* * * * *" },
    { "path": "/api/cron/venue-emails", "schedule": "* * * * *" },
    { "path": "/api/cron/venue-email-preparation", "schedule": "* * * * *" },
    { "path": "/api/cron/venue-campaigns", "schedule": "* * * * *" },
    { "path": "/api/cron/photo-upload-cleanup", "schedule": "*/10 * * * *" },
    {
      "path": "/api/cron/internal-request-push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/image-moderation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/video-moderation",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/cron/dmca-restoration",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/shift-checkins",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/finance",
      "schedule": "0 10 * * *"
    }
  ]
}
